# macOS
.DS_Store

# Generated Xcode container app + extension (build artifact — regenerate with the
# safari-web-extension-converter; `extension/` is the canonical source of truth).
/Map Path/*
# ...except the pointer that loads this repo's rules into Xcode's agent,
# which opens in Map Path/. Regenerating the tree would otherwise lose it.
!/Map Path/CLAUDE.md
*.xcodeproj
*.xcworkspace
DerivedData/
build/
*.xcuserstate
xcuserdata/

# Node / tooling (icon pipeline, if used locally)
node_modules/

# Internal build/handoff doc — local only, not for the public repo
HANDOFF.md
